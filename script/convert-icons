#!/usr/bin/env bash

# Exit the script if any command fails
set -e

# convert-icons - Script to convert SVG icons to PNG for Stream Deck plugin
# Uses ImageMagick's modern 'magick' command

if ! command -v magick &> /dev/null; then
  echo "❌ Error: ImageMagick is not installed or not in PATH"
  echo "   Please install ImageMagick with: brew install imagemagick"
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BASE_DIR="$SCRIPT_DIR/../com.max-beizer.elgato-teams-video.sdPlugin/imgs/actions"

if [ ! -d "$BASE_DIR" ]; then
  echo "❌ Error: Base directory does not exist: $BASE_DIR"
  exit 1
fi

convert_icons() {
  local action_dir="$1"

  echo "Converting icons for $action_dir..."

  # Small icon (for catalog)
  if [ -f "$BASE_DIR/$action_dir/icon.svg" ]; then
    echo "  Converting icon.svg to icon.png"
    magick "$BASE_DIR/$action_dir/icon.svg" -resize 20x20 "$BASE_DIR/$action_dir/icon.png"
    magick "$BASE_DIR/$action_dir/icon.svg" -resize 40x40 "$BASE_DIR/$action_dir/icon@2x.png"
  fi

  case "$action_dir" in
    "teams-mute-toggle")
      if [ -f "$BASE_DIR/$action_dir/muted.svg" ]; then
        echo "  Converting muted.svg to key_0.png"
        magick "$BASE_DIR/$action_dir/muted.svg" -resize 72x72 "$BASE_DIR/$action_dir/key_0.png"
        magick "$BASE_DIR/$action_dir/muted.svg" -resize 144x144 "$BASE_DIR/$action_dir/key_0@2x.png"
      fi
      if [ -f "$BASE_DIR/$action_dir/unmuted.svg" ]; then
        echo "  Converting unmuted.svg to key_1.png"
        magick "$BASE_DIR/$action_dir/unmuted.svg" -resize 72x72 "$BASE_DIR/$action_dir/key_1.png"
        magick "$BASE_DIR/$action_dir/unmuted.svg" -resize 144x144 "$BASE_DIR/$action_dir/key_1@2x.png"
      fi
      ;;
    "teams-video-toggle")
      if [ -f "$BASE_DIR/$action_dir/video-off.svg" ]; then
        echo "  Converting video-off.svg to key_0.png"
        magick "$BASE_DIR/$action_dir/video-off.svg" -resize 72x72 "$BASE_DIR/$action_dir/key_0.png"
        magick "$BASE_DIR/$action_dir/video-off.svg" -resize 144x144 "$BASE_DIR/$action_dir/key_0@2x.png"
      fi
      if [ -f "$BASE_DIR/$action_dir/video-on.svg" ]; then
        echo "  Converting video-on.svg to key_1.png"
        magick "$BASE_DIR/$action_dir/video-on.svg" -resize 72x72 "$BASE_DIR/$action_dir/key_1.png"
        magick "$BASE_DIR/$action_dir/video-on.svg" -resize 144x144 "$BASE_DIR/$action_dir/key_1@2x.png"
      fi
      ;;
    "teams-share-screen")
      if [ -f "$BASE_DIR/$action_dir/not-sharing.svg" ]; then
        echo "  Converting not-sharing.svg to key_0.png"
        magick "$BASE_DIR/$action_dir/not-sharing.svg" -resize 72x72 "$BASE_DIR/$action_dir/key_0.png"
        magick "$BASE_DIR/$action_dir/not-sharing.svg" -resize 144x144 "$BASE_DIR/$action_dir/key_0@2x.png"
      fi
      if [ -f "$BASE_DIR/$action_dir/sharing.svg" ]; then
        echo "  Converting sharing.svg to key_1.png"
        magick "$BASE_DIR/$action_dir/sharing.svg" -resize 72x72 "$BASE_DIR/$action_dir/key_1.png"
        magick "$BASE_DIR/$action_dir/sharing.svg" -resize 144x144 "$BASE_DIR/$action_dir/key_1@2x.png"
      fi
      ;;
    "teams-focus")
      if [ -f "$BASE_DIR/$action_dir/teams-running.svg" ]; then
        echo "  Converting teams-running.svg to key_0.png"
        magick "$BASE_DIR/$action_dir/teams-running.svg" -resize 72x72 "$BASE_DIR/$action_dir/key_0.png"
        magick "$BASE_DIR/$action_dir/teams-running.svg" -resize 144x144 "$BASE_DIR/$action_dir/key_0@2x.png"
      fi
      if [ -f "$BASE_DIR/$action_dir/no-teams.svg" ]; then
        echo "  Converting no-teams.svg to key_1.png"
        magick "$BASE_DIR/$action_dir/no-teams.svg" -resize 72x72 "$BASE_DIR/$action_dir/key_1.png"
        magick "$BASE_DIR/$action_dir/no-teams.svg" -resize 144x144 "$BASE_DIR/$action_dir/key_1@2x.png"
      fi
      ;;
    "teams-leave-meeting")
      if [ -f "$BASE_DIR/$action_dir/in-meeting.svg" ]; then
        echo "  Converting in-meeting.svg to key_0.png"
        magick "$BASE_DIR/$action_dir/in-meeting.svg" -resize 72x72 "$BASE_DIR/$action_dir/key_0.png"
        magick "$BASE_DIR/$action_dir/in-meeting.svg" -resize 144x144 "$BASE_DIR/$action_dir/key_0@2x.png"
      fi
      if [ -f "$BASE_DIR/$action_dir/no-meeting.svg" ]; then
        echo "  Converting no-meeting.svg to key_1.png"
        magick "$BASE_DIR/$action_dir/no-meeting.svg" -resize 72x72 "$BASE_DIR/$action_dir/key_1.png"
        magick "$BASE_DIR/$action_dir/no-meeting.svg" -resize 144x144 "$BASE_DIR/$action_dir/key_1@2x.png"
      fi
      ;;
  esac
}

action_count=0
for action_dir in $(ls "$BASE_DIR"); do
  if [ -d "$BASE_DIR/$action_dir" ]; then
    convert_icons "$action_dir"
    ((action_count++))
  fi
done

echo "✅ All icons converted successfully! Processed $action_count actions."
echo "📁 Icons saved to: $BASE_DIR"
